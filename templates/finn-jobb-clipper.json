{
	"schemaVersion": "0.1.0",
	"name": "Finn Jobb",
	"behavior": "create",
	"noteContentFormat": "\n> Publisert: {{selector:time?datetime|last}}\n> Frist: {{schema:[1]:script:ld\\+json.validThrough}}\n\n{{selectorHtml:section[aria-label=\"Jobbdetaljer\"]|markdown}}\n\n# Tilleggsinformasjon\n\n{{selectorHtml:article > aside|markdown}}",
	"properties": [
		{
			"name": "created",
			"value": "{{time|date:\\\"YYYY-MM-DDTHH:mm:ssZ\\\"}}",
			"type": "datetime"
		},
		{
			"name": "reviewed",
			"value": "",
			"type": "datetime"
		},
		{
			"name": "url",
			"value": "{{url}}",
			"type": "text"
		},
		{
			"name": "title",
			"value": "{{title}}",
			"type": "text"
		},
		{
			"name": "author",
			"value": "{{author|split:\\\",\\\"|join}}",
			"type": "multitext"
		},
		{
			"name": "published",
			"value": "{{selector:time?datetime|last}}",
			"type": "datetime"
		},
		{
			"name": "description",
			"value": "{{description}}",
			"type": "text"
		},
		{
			"name": "tags",
			"value": "webclip/finn",
			"type": "multitext"
		},
		{
			"name": "status",
			"value": "unread",
			"type": "text"
		}
	],
	"triggers": [
		"https://www.finn.no/job"
	],
	"noteNameFormat": "{{schema:[1]:script:ld\\+json.datePosted|date:\"YYYY-MM-DD\"}} FINN {{title|safe_name}}",
	"path": "webclips"
}